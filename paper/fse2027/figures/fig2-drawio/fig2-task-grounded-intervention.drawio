<mxCell id="returning" value="Return n" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=24;fillColor=#F4AB6F;strokeColor=#20242A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1555" y="390" width="170" height="75" as="geometry"/></mxCell>
<mxCell id="candidate" value="Candidate r: bind u as a SQL value&lt;br&gt;Source expression: unexpressed&lt;br&gt;External requirement query" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=23;fillColor=#F1E7F8;strokeColor=#8442AA;fontColor=#61367D;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="365" width="480" height="115" as="geometry"/></mxCell>
<mxCell id="readout" value="I&lt;sub&gt;G&lt;/sub&gt;(Delete): selection obligation&lt;br&gt;Complete condition + scope&lt;br&gt;Source evidence retained" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=22;fillColor=#E1EDF9;strokeColor=#20242A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="365" width="350" height="115" as="geometry"/></mxCell>
