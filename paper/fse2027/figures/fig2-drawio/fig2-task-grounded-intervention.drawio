<mxCell id="shared" value="Common scope: identifier u at database deletion" style="text;html=1;align=left;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;fontColor=#004496;" vertex="1" parent="1"><mxGeometry x="45" y="665" width="910" height="50" as="geometry"/></mxCell>
<mxCell id="target" value="&lt;b&gt;Requirement Introduction T&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; (A=1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pass the identifier separately&lt;br&gt;as a bound SQL value parameter." style="shape=note;whiteSpace=wrap;html=1;spacing=15;fontFamily=Comic Sans MS;fontSize=23;fillColor=#F1E7F8;strokeColor=#8442AA;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="740" width="435" height="165" as="geometry"/></mxCell>
<mxCell id="reference" value="&lt;b&gt;Matched reference (A=0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the identifier to select&lt;br&gt;the records to delete as requested." style="shape=note;whiteSpace=wrap;html=1;spacing=15;fontFamily=Comic Sans MS;fontSize=23;fillColor=#F5F6F8;strokeColor=#626B7C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="510" y="740" width="445" height="165" as="geometry"/></mxCell>
<mxCell id="contrast" value="Target effect: τ&lt;sub&gt;r&lt;/sub&gt; = E&lt;sub&gt;T&lt;/sub&gt;[Y(1) − Y(0)]&lt;br&gt;Both prompts retain selection and return obligations." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=24;fillColor=#EAECF0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="45" y="955" width="910" height="85" as="geometry"/></mxCell>
<mxCell id="explanation" value="&lt;b&gt;Explain the tested scope&lt;/b&gt;&lt;br&gt;Parameter binding concerns identifier u&lt;br&gt;at the deletion operation.&lt;br&gt;Preserve selection and returned count." style="shape=note;whiteSpace=wrap;html=1;spacing=15;fontFamily=Comic Sans MS;fontSize=25;fillColor=#E1EDF9;strokeColor=#20242A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="675" width="710" height="155" as="geometry"/></mxCell>
<mxCell id="evidence" value="Report actual evidence when available&lt;br&gt;Effect + interval + status&lt;br&gt;Functionality, Oracle coverage, unknowns" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=24;fillColor=#FFF3DB;strokeColor=#C28A2A;fontColor=#80561E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="860" width="710" height="105" as="geometry"/></mxCell>
<mxCell id="action" value="&lt;b&gt;Evaluate this scoped modification.&lt;/b&gt;&lt;br&gt;Adoption depends on the declared evidence." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Comic Sans MS;fontSize=24;fillColor=#DEF1D7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1040" y="990" width="710" height="65" as="geometry"/></mxCell>
<mxCell id="footer" value="Conceptual example: task binding, prompt realizations, and the reporting contract" style="text;html=1;align=center;fontFamily=Comic Sans MS;fontSize=21;fontColor=#626B7C;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1720" height="45" as="geometry"/></mxCell>
