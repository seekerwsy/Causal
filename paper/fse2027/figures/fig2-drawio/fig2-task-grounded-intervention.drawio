<mxCell id="used-count" value="used_by" style="endArrow=classic;html=1;fontFamily=Comic Sans MS;fontSize=22;fontColor=#004496;strokeColor=#004496;strokeWidth=2.5;labelBackgroundColor=#FAFCFE;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="count" target="returning"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="232.5"/></Array></mxGeometry></mxCell>
<mxCell id="scope-query" value="scope query" style="dashed=1;endArrow=classic;html=1;fontFamily=Comic Sans MS;fontSize=21;fontColor=#8442AA;strokeColor=#8442AA;strokeWidth=2.5;labelBackgroundColor=#FAFCFE;exitX=0.7;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="candidate" target="deletion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="956" y="320"/><mxPoint x="1030" y="320"/></Array></mxGeometry></mxCell>
