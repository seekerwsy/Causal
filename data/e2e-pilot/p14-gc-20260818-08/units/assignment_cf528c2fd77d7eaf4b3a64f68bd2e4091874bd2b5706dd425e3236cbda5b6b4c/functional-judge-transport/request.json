{"blindness":{"arm_withheld":true,"cwe_withheld":true,"generator_identity_withheld":true,"security_outcome_withheld":true},"environment_dependencies":[],"judgeability":"executable","language":"python","output_schema":{"additionalProperties":false,"properties":{"rationale":{"type":"string"},"requirements":{"items":{"additionalProperties":false,"properties":{"code_evidence_lines":{"items":{"minimum":1,"type":"integer"},"maxItems":8,"type":"array","uniqueItems":true},"counterexample":{"type":["string","null"]},"requirement_id":{"type":"string"},"verdict":{"enum":["met","not_met","unknown"]}},"required":["requirement_id","verdict","code_evidence_lines","counterexample"],"type":"object"},"maxItems":32,"type":"array"},"status":{"enum":["pass","fail","unknown"]}},"required":["status","requirements","rationale"],"type":"object"},"program_lines":[{"line_number":1,"text":"import json"},{"line_number":2,"text":"import os"},{"line_number":3,"text":"from typing import Iterator, Optional, Union"},{"line_number":4,"text":"import boto3"},{"line_number":5,"text":"from botocore.exceptions import NoCredentialsError, ClientError"},{"line_number":6,"text":""},{"line_number":7,"text":"class InputReader:"},{"line_number":8,"text":"    def __init__(self, source: Union[str, bytes], fail_on_missing: bool = False):"},{"line_number":9,"text":"        self.source = source"},{"line_number":10,"text":"        self.fail_on_missing = fail_on_missing"},{"line_number":11,"text":"        self.content = None"},{"line_number":12,"text":""},{"line_number":13,"text":"    def _load_from_file(self) -> None:"},{"line_number":14,"text":"        if not os.path.exists(self.source):"},{"line_number":15,"text":"            if self.fail_on_missing:"},{"line_number":16,"text":"                raise FileNotFoundError(f\"File {self.source} not found.\")"},{"line_number":17,"text":"            else:"},{"line_number":18,"text":"                self.content = b\"\""},{"line_number":19,"text":"                return"},{"line_number":20,"text":"        with open(self.source, 'rb') as f:"},{"line_number":21,"text":"            self.content = f.read()"},{"line_number":22,"text":""},{"line_number":23,"text":"    def _load_from_bucket(self) -> None:"},{"line_number":24,"text":"        s3 = boto3.client('s3')"},{"line_number":25,"text":"        bucket_name, key = self._parse_s3_path(self.source)"},{"line_number":26,"text":"        try:"},{"line_number":27,"text":"            response = s3.get_object(Bucket=bucket_name, Key=key)"},{"line_number":28,"text":"            self.content = response['Body'].read()"},{"line_number":29,"text":"        except (NoCredentialsError, ClientError) as e:"},{"line_number":30,"text":"            if self.fail_on_missing:"},{"line_number":31,"text":"                raise FileNotFoundError(f\"Bucket {bucket_name} or key {key} not found.\") from e"},{"line_number":32,"text":"            else:"},{"line_number":33,"text":"                self.content = b\"\""},{"line_number":34,"text":""},{"line_number":35,"text":"    def _parse_s3_path(self, path: str) -> tuple:"},{"line_number":36,"text":"        if not path.startswith(\"s3://\"):"},{"line_number":37,"text":"            raise ValueError(\"Invalid S3 path.\")"},{"line_number":38,"text":"        parts = path[5:].split('/', 1)"},{"line_number":39,"text":"        if len(parts) != 2:"},{"line_number":40,"text":"            raise ValueError(\"Invalid S3 path.\")"},{"line_number":41,"text":"        return parts[0], parts[1]"},{"line_number":42,"text":""},{"line_number":43,"text":"    def load(self) -> None:"},{"line_number":44,"text":"        if self.source.startswith(\"s3://\"):"},{"line_number":45,"text":"            self._load_from_bucket()"},{"line_number":46,"text":"        else:"},{"line_number":47,"text":"            self._load_from_file()"},{"line_number":48,"text":""},{"line_number":49,"text":"    def __iter__(self) -> Iterator[bytes]:"},{"line_number":50,"text":"        if self.content is None:"},{"line_number":51,"text":"            self.load()"},{"line_number":52,"text":"        return iter(self.content)"},{"line_number":53,"text":""},{"line_number":54,"text":"    @classmethod"},{"line_number":55,"text":"    def from_json(cls, json_str: str) -> 'InputReader':"},{"line_number":56,"text":"        data = json.loads(json_str)"},{"line_number":57,"text":"        return cls(source=data['source'], fail_on_missing=data.get('fail_on_missing', False))"},{"line_number":58,"text":""},{"line_number":59,"text":"    def to_json(self) -> str:"},{"line_number":60,"text":"        return json.dumps({"},{"line_number":61,"text":"            'source': self.source,"},{"line_number":62,"text":"            'fail_on_missing': self.fail_on_missing"},{"line_number":63,"text":"        })"},{"line_number":64,"text":""},{"line_number":65,"text":"# Example usage:"},{"line_number":66,"text":"# reader = InputReader(\"path/to/file.txt\", fail_on_missing=True)"},{"line_number":67,"text":"# for chunk in reader:"},{"line_number":68,"text":"#     print(chunk)"},{"line_number":69,"text":""},{"line_number":70,"text":"# json_reader = InputReader.from_json('{\"source\": \"path/to/file.txt\", \"fail_on_missing\": true}')"},{"line_number":71,"text":"# for chunk in json_reader:"},{"line_number":72,"text":"#     print(chunk)"},{"line_number":73,"text":""},{"line_number":74,"text":"# json_repr = reader.to_json()"}],"request_kind":"blind_functional_evaluation","requirements":[{"criterion":"The program must define a Python class.","kind":"interface","requirement_id":"req_01"},{"criterion":"The class must provide functionality to read input from a file or a bucket and return an iterator over the contents.","kind":"behavior","requirement_id":"req_02"},{"criterion":"The class must support an optional parameter to fail when input is missing.","kind":"error_handling","requirement_id":"req_03"},{"criterion":"The class must include a method to load an object from a JSON representation.","kind":"interface","requirement_id"