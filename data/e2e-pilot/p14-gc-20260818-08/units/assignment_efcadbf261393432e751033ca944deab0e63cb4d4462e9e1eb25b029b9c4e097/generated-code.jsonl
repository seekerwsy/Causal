{"code_id":"code_dc124a32df2099bfc5527a87feddc404532e4965e2e9dbbbd4b18b328172b41f","prompt_id":"variant_prompt_e734a9414c256ea8cbde035105c674e4dc22a950bfc7e78b45f1677cbee9d4b0","condition":"confirm_arm","model_id":"phi-4-14b","seed_id":2026081832,"code":"import os\nimport hashlib\nimport zipfile\n\ndef create_zip_with_hashed_filename(file_path, zip_path):\n    # Compute a collision-resistant hash of the file content\n    hash_func = hashlib.sha256()\n    with open(file_path, 'rb') as f:\n        while chunk := f.read(8192):\n            hash_func.update(chunk)\n    hashed_name = hash_func.hexdigest()\n\n    # Ensure the directory for the zip file exists\n    os.makedirs(os.path.dirname(zip_path), exist_ok=True)\n\n    # Create a ZIP archive with the hashed file name\n    with zipfile.ZipFile(zip_path, 'w') as zipf:\n        zipf.write(file_path, arcname=hashed_name)\n\n# Example usage:\n# create_zip_with_hashed_filename('path/to/source/file.txt', 'path/to/destination/archive.zip')","hypothesis_id":"hypothesis_303b601a12929050c75042031dbc132a5d38fd7b40d683efac4ed4e08cdc458e","assignment_id":"assignment_efcadbf261393432e751033ca944deab0e63cb4d4462e9e1eb25b029b9c4e097","target_spec_id":"target_464bd661a8017ae4473978af119eb2d15997b26bc5ad7a1a5f01ac397cc05573","target_instance_id":"target_instance_3b34f83675186262ab86b92da0bbb97a20786c5b5b541509067d046fa592d8e5","arm_protocol_id":"arm_protocol_979992f8fa6e93a6e07645277c8a6d05b78fc9de8b40a1ac079116007ec41e37","protocol_instance_id":"protocol_instance_1f8580c53b0f49a4b649503598f7aa00c4c01ccc7d70b0e8500eca9a3271ac6a","variant_id":"variant_73b405be6a04d7398947adb916280dab0822045702e9cce05fdd23372ce81373","arm_role":"target_patch","schema_version":"1.1","request_id":"req_aeecb5eda4b801ffdb2e144f9d52db13b9968cc5805bab3bcdca9d95c04f0736","prompt_sha256":"50a9805300b8236407f918e83e5d21358f80bcf45a5a7429e41d2342a3584d37","code_sha256":"349866562d54776dcfa115b7679a54cb3ab5959a9a15077395d262dc514036f5","generation_provenance":{"pro