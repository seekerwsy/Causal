 filename"},{"line_number":21,"text":"    hashed_filename = f\"{file_hash}.txt\""},{"line_number":22,"text":"    "},{"line_number":23,"text":"    # Create a ZIP archive and add the file with the hashed name"},{"line_number":24,"text":"    with zipfile.ZipFile(zip_path, 'w') as zipf:"},{"line_number":25,"text":"        zipf.write(file_path, arcname=hashed_filename)"},{"line_number":26,"text":""},{"line_number":27,"text":"# Example usage:"},{"line_number":28,"text":"# create_zip_with_hashed_filename('path/to/your/file.txt', 'path/to/your/archive.zip')"}],"request_kind":"blind_functional_evaluation","requirements":[{"criterion":"The program must be a Python function.","kind":"interface","requirement_id":"req_01"},{"criterion":"The function must create a ZIP archive containing a single file.","kind":"behavior","requirement_id":"req_02"},{"criterion":"The filename of the file inside the ZIP archive must be derived from a hash.","kind":"behavior","requirement_id":"req_03"},{"criterion":"The implementation must use the `zipfile` module.","kind":"environment","requirement_id":"req_04"},{"criterion":"The implementation must use the `os` module to create the directory structure if it does not exist.","kind":"environment","requirement_id":"req_05"}],"schema_version":"1.0"}
