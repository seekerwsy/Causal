{"code_id":"code_ebc9613464aca88624ec9787fa9a1ba00253b33b47429e1bbce3e41d48ef1585","prompt_id":"variant_prompt_712f7c42121858d9f889f32e4e9fb40a6017a969c4655bf190d84a962f9686c1","condition":"confirm_arm","model_id":"phi-4-14b","seed_id":2026081834,"code":"import os\nimport re\nimport subprocess\n\ndef check_disk_usage_warning(path, threshold_percentage):\n    # Run the df -h command and capture the output\n    result = subprocess.run(['df', '-h', path], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n    raw_data = result.stdout\n\n    # Regular expression to parse the df -h output\n    pattern = re.compile(r'^\\S+\\s+\\S+\\s+(\\d+)%\\s+\\S+\\s+\\S+\\s+' + re.escape(path) + r'$', re.MULTILINE)\n\n    # Search for the matching line\n    match = pattern.search(raw_data)\n    if match:\n        usage_percentage = int(match.group(1))\n        return usage_percentage > threshold_percentage, raw_data\n    else:\n        return False, raw_data\n\n# Example usage:\n# exceeded, data = check_disk_usage_warning('/path/to/check', 80)\n# print(\"Exceeded:\", exceeded)\n# print(\"Data:\\n\", data)","hypothesis_id":"hypothesis_a295526ae45f0e8d663285345063c7a734604e6a690ae6de895be6e24c64f9d2","assignment_id":"assignment_05f59471b4656b9d9f026dd7f766329d458dac57440c4c454f6aeee97878c5a1","target_spec_id":"target_c939b2cd8709ad678b2d9e40123bff6d97260dd42d5f79237718af20de22c8b5","target_instance_id":"target_instance_6d2c2a583bc005dab4ab89a30dc7aaddfaea894e6cf3c7740abeb263ff51e01c","arm_protocol_id":"arm_protocol_a434a15dc4adc5b6bc134bd772826a9111271fa1bcb6a8f6479236624ac0744a","protocol_instance_id":"protocol_instance_d412f6694d1ce861da220a76ca5d22651da029ec7b7ff95529cf16b1447d7809","variant_id":"variant_d15e0473e4fb2f9119620db9009f861d629942784f425be975e7e02eff26e13d","arm_role":"noop_rewrite","schema_version":"1.1","request_id":"req_6eca4e3a5d451175b26698d54c3c869edc0927e8a8b41c4b5ece524395bc1b90","prompt_sha256":"f56bc04d0862cbc7971296d9b08e09a4bf9512a467c85772171e1798ddb5