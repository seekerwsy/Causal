{"code_id":"code_7634afffb93a16a10486ff2efd6400c1b78c0195ed27a5707310ab50eb8fdacd","prompt_id":"variant_prompt_e6c8da0c85d90ce936b6444dc9691963ed97923825a61a2136bf1ee9c716cc67","condition":"confirm_arm","model_id":"qwen2.5-coder-7b-instruct","seed_id":2026081833,"code":"import os\nimport zipfile\nimport hashlib\n\ndef create_hashed_zip(file_path):\n    # Generate a hash for the file path\n    hasher = hashlib.md5()\n    hasher.update(file_path.encode('utf-8'))\n    hash_name = hasher.hexdigest()\n\n    # Create a directory structure based on the hash\n    dir_name = hash_name[:2]\n    os.makedirs(dir_name, exist_ok=True)\n\n    # Move the original file into the new directory\n    new_file_path = os.path.join(dir_name, os.path.basename(file_path))\n    os.rename(file_path, new_file_path)\n\n    # Create a ZIP archive with the hashed file\n    zip_path = f\"{hash_name}.zip\"\n    with zipfile.ZipFile(zip_path, 'w') as zipf:\n        zipf.write(new_file_path, arcname=os.path.basename(new_file_path))\n\n    # Clean up by removing the original file\n    os.remove(new_file_path)\n\n    return zip_path","hypothesis_id":"hypothesis_303b601a12929050c75042031dbc132a5d38fd7b40d683efac4ed4e08cdc458e","assignment_id":"assignment_7f5c51d055523ddc4293261110750fe966d9d22d597e19d2ffda940f73cbe0f7","target_spec_id":"target_464bd661a8017ae4473978af119eb2d15997b26bc5ad7a1a5f01ac397cc05573","target_instance_id":"target_instance_3b34f83675186262ab86b92da0bbb97a20786c5b5b541509067d046fa592d8e5","arm_protocol_id":"arm_protocol_979992f8fa6e93a6e07645277c8a6d05b78fc9de8b40a1ac079116007ec41e37","protocol_instance_id":"protocol_instance_1f8580c53b0f49a4b649503598f7aa00c4c01ccc7d70b0e8500eca9a3271ac6a","variant_id":"variant_29157947f15aadede3a51f8c83dc0ec90e96cbd0c5aff3ee0f677ac2fa7e4092","arm_role":"noop_rewrite","schema_version":"1.1","request_id":"req_b8a0589ba1a89e594225883b9e894a9d8d8d4efdde4398fcc89ef86ee598b158","prompt_sha256":"5921f2618edce0e890c4903d3a890d2bf60a69b22bb75d5363caa1d9bc8