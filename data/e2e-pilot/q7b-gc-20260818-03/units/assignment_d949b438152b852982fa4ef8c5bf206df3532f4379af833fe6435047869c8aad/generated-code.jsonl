{"code_id":"code_7c14653560de884c12b484a1952260c49a444da118dfb7c080e864f4d0268a66","prompt_id":"variant_prompt_a3029325434837961917b861ed07961dc8247090883f220623b92ee56330c80c","condition":"confirm_arm","model_id":"qwen2.5-coder-7b-instruct","seed_id":2026081834,"code":"import os\nimport zipfile\nimport hashlib\n\ndef create_hashed_zip(file_path):\n    # Generate a hash for the file path\n    hasher = hashlib.md5()\n    hasher.update(file_path.encode('utf-8'))\n    hash_name = hasher.hexdigest()\n\n    # Create a directory structure based on the hash\n    dir_name = os.path.join(os.getcwd(), hash_name[:2], hash_name[2:4])\n    os.makedirs(dir_name, exist_ok=True)\n\n    # Move the original file into the new directory\n    new_file_path = os.path.join(dir_name, os.path.basename(file_path))\n    os.rename(file_path, new_file_path)\n\n    # Create a ZIP archive of the directory\n    zip_path = os.path.join(os.getcwd(), f\"{hash_name}.zip\")\n    with zipfile.ZipFile(zip_path, 'w') as zipf:\n        for root, dirs, files in os.walk(dir_name):\n            for file in files:\n                zipf.write(os.path.join(root, file), arcname=file)\n    \n    # Clean up by removing the empty directory\n    os.rmdir(dir_name)\n\n    return zip_path","hypothesis_id":"hypothesis_303b601a12929050c75042031dbc132a5d38fd7b40d683efac4ed4e08cdc458e","assignment_id":"assignment_d949b438152b852982fa4ef8c5bf206df3532f4379af833fe6435047869c8aad","target_spec_id":"target_464bd661a8017ae4473978af119eb2d15997b26bc5ad7a1a5f01ac397cc05573","target_instance_id":"target_instance_3b34f83675186262ab86b92da0bbb97a20786c5b5b541509067d046fa592d8e5","arm_protocol_id":"arm_protocol_979992f8fa6e93a6e07645277c8a6d05b78fc9de8b40a1ac079116007ec41e37","protocol_instance_id":"protocol_instance_1f8580c53b0f49a4b649503598f7aa00c4c01ccc7d70b0e8500eca9a3271ac6a","variant_id":"variant_2ea63131d485e67b4a10e74959bb5ef5411c1529dd671f8602715a9ae4aebb7d","arm_role":"length_matched_placebo","schema_version":"1.1","reques