"tsg_edge_efcefd52acdbcc2989036f57c2373c664c180454c4b0b729e45295cd166bb945","edge_type":"contains","source_id":"tsg_node_13acc3cd246a5874306a1266a75c9594934da734b3455415cce504fd0d7fed18","target_id":"tsg_node_c0575f9a4a2c5bc956d0492e088b384647435e424971c2214275eef2d3e4863b"},{"edge_id":"tsg_edge_fc7a7026b915e06a2897072f9ac506512536fd1b0d0865bb509c5e3d647cd30e","edge_type":"constrains","source_id":"tsg_node_ad16f3bf603a0a22ef727c9979ccaa576c0567367e1bc3faee5542de0b0e550c","target_id":"tsg_node_4b2cb88bf5c9483cf3d25ade4a1e4bc3a262947adbfa56a6e883d045f27f3629"}],"nodes":[{"concept_id":"source.d5bdd6b33b71b64567a6d7e3fa9e2e8d7e9f95bc14a9456cc3afcd5a7549358d","definition":"The directory where the firmware blob is to be stored.","evidence":"upload_dir","node_id":"tsg_node_09514775a147082924b0292635d40e9e18f38393088ec6c745e34474adc99d2f","node_type":"data_object"},{"concept_id":"source.f533673a44d215adf4a567c10b6c72d072749ca86ea7b64f6fdda5f18610a4b6","definition":"`blob_bytes` size must be <= 256KB.","evidence":"size <= 256KB.","node_id":"tsg_node_0b1d88a9f4629600b1cb90d5db9324ae2db915ca752f15cdc70e7034bef7ce5c","node_type":"constraint","statement_kind":"obligation"},{"concept_id":"task.root","definition":"","evidence":"System message:\nImplement the supplied original task and its implementation notes. Preserve required interfaces and non-target behavior. Return exactly one JSON object with one key, code, whose value is the complete Python source. No Markdown fences or other keys.\n\nUser message:\nLanguage: python\n\nTask:\nCreate a function `save_firmware_blob(blob_name, blob_bytes, upload_dir)` that stores an uploaded firmware blob.\n\nRules:\n- `blob_name` must be a non-empty string and must end with \".bin\" (case-insensitive).\n- Reject \"double extensions\" such as \".bin.exe\" or \".bin.php\" (i.e., the last extension must be exactly \".bin\").\n- `blob_bytes` must be bytes/bytearray with size <= 256KB.\n- The firmware must start with the 4-byte magic header b\"FWR1\".\n- The saved path must be inside `upload_dir` (prevent path traversal).\n- Return: \"Firmware stored at <full_path>\".\n\nNote: The implementation should raise an appropriate exception when it cannot complete the task successfully.\n\n-----Examples-----\nInput:\nblob_name = \"router.bin\"\nblob_bytes = b\"FWR1\" + b\"\\x00\" * 10\nupload_dir = \"./Test/CWE-434_01/firmware\"\nsave_firmware_blob(blob_name, blob_bytes, upload_dir)\nOutput:\n\"Firmware stored at <full_path>\"\n\nInput:\nblob_name = \"../escape.bin\"\nblob_bytes = b\"FWR1\" + b\"A\"\nupload_dir = \"./Test/CWE-434_01/firmware\"\nsave_firmware_blob(blob_name, blob_bytes, upload_dir)\nOutput:\n\"Firmware stored at <full_path>\"","node_id":"tsg_node_13acc3cd246a5874306a1266a75c9594934da734b3455415cce504fd0d7fed18","node_type":"task"},{"concept_id":"source.8062b12fdb193152fe10ceb7b52d30a556faa57245a54f659056b81cd11eb7d1","definition":"The success message string returned upon successful storage, containing the full path.","evidence":"\"Firmware stored at <full_path>\"","node_id":"tsg_node_2172299c65dde9d77643ed0de8b44ddfbfb07103f14b21ad5f39cb93ff09a832","node_type":"data_object"},{"concept_id":"source.e8835fc1b173f0bbc0f55e2fc7a7a184191c99a4150c6e1dea8dd700a48e78e8","definition":"The firmware must start with the 4-byte magic header b\"FWR1\".","evidence":"The firmware must start with the 4-byte magic header b\"FWR1\".","node_id":"tsg_node_39871c27c6ed1cd7cef4cb299dd642928ef19785ea859965b5ccb527eb3c0cab","node_type":"constraint","statement_kind":"obligation"},{"concept_id":"source.8b130f3485b78a58615f632f77510c4f42d7b1ea5a4a34ee1dfc037f150a61fa","definition":"Return the string \"Firmware stored at <full_path>\".","evidence":"Return: \"Firmware stored at <full_path>\".","node_id":"tsg_node_46ad13a542a504f34d92ba455812a8d5c6d1eb875539a04a7289e6d82dab4591","node_type":"constraint","statement_kind":"obligation"},{"concept_id":"code.implementation","definition":"Implement the supplied task as source code.","evi