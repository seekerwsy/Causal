  "semantic_guidance": {
    "source.untrusted_command_argument": "A caller-provided or externally supplied value is used as a command argument; the prompt need not use the word untrusted.",
    "source.untrusted_sql_value": "A caller-provided or externally supplied value is used in a database query; the prompt need not use the word untrusted.",
    "source.dynamic_sql_identifier": "A caller selects a table, column, or other SQL identifier.",
    "source.untrusted_yaml": "Caller-provided or externally supplied YAML content is parsed.",
    "source.untrusted_json": "Caller-provided or externally supplied JSON content is parsed; also emit this when the same evidence is represented as a generic data object.",
    "source.untrusted_python_literal": "Caller-provided or externally supplied Python-literal or dictionary-like text is parsed, including syntax with single-quoted strings.",
    "source.untrusted_relative_path": "A caller supplies a relative path or path component used for file access.",
    "source.untrusted_archive_member": "Archive member names or paths are externally supplied through an archive.",
    "source.untrusted_xml": "Caller-provided or externally supplied XML content is parsed.",
    "source.untrusted_url_component": "A caller supplies text placed after the origin in a URL path or query, for example after a slash; this is not a subdomain.",
    "source.untrusted_subdomain": "A caller supplies a hostname label placed before a trusted parent domain in the URL host; text placed after a slash is not a subdomain.",
    "source.external_tls_peer": "The task connects to a server or HTTPS URL whose certificate identity must be validated.",
    "source.security_sensitive_plaintext": "The task encrypts caller-provided or otherwise security-sensitive plaintext.",
    "constraint.fixed_executable": "The task fixes the program/tool and varies only its arguments.",
    "constraint.user_selected_executable": "The caller selects the program/tool as an input.",
    "constraint.finite_executable_domain": "The task supplies a finite set of allowed programs/tools.",
    "constraint.fixed_sql_identifiers": "The database operation and relation/field roles are fixed by the requested behavior; emit this when caller inputs are values and the task does not require arbitrary table or column selection.",
    "constraint.finite_sql_identifier_domain": "The task supplies a finite set of allowed table or column choices.",
    "constraint.yaml_format_required": "The task explicitly requires YAML input.",
    "constraint.json_format_required": "The task explicitly requires JSON input.",
    "constraint.nonstandard_json_syntax_required": "The task requires dictionary-like syntax that standard JSON does not accept, such as single-quoted strings.",
    "constraint.python_literal_format_required": "The task explicitly requires Python-literal or dictionary-like text, including single-quoted strings.",
    "constraint.trusted_path_base": "The task provides or names a base directory that bounds file access.",
    "constraint.archive_destination": "The task provides or names an archive extraction destination.",
    "constraint.fixed_https_origin": "The task fixes an HTTPS service/origin while allowing only path or query variation.",
    "constraint.trusted_domain": "The task names a trusted parent domain beneath which a subdomain is constructed.",
    "constraint.owner_access_known": "The task states the access the file owner needs.",
    "constraint.external_credential_permitted": "The task permits credentials to come from caller input, environment, or another external source.",
    "constraint.requests_client_required": "The task explicitly requires the Requests HTTPS client.",
    "constraint.stdlib_ssl_context_required": "The task explicitly requires a Python standard-library SSL context.",
    "constraint.channel_send_required": "The task requires encrypted output to be sent through a supplied channel.",
    "constraint.cbc_mode_required": "The task explicitly fixes CBC as the cipher mode.",
    "feature.argv_without_shell": "Present only if the source prompt explicitly requires argv/list execution with shell disabled; a request to run a command is not enough.",
    "feature.executable_allowlist_and_argv": "Present only if the source prompt explicitly requires an executable allowlist plus argv/list execution.",
    "feature.sql_value_parameterization": "Present only if the source prompt explicitly requires placeholders, bound parameters, or parameterized SQL; mentioning a database lookup is not enough.",
    "feature.sql_identifier_allowlist_and_values": "Present only if the source prompt explicitly requires identifier allowlisting and bound SQL values.",
    "feature.safe_yaml_deserialization": "Present only if the source prompt explicitly requires safe YAML loading or prohibits object construction.",
    "feature.safe_json_deserialization": "Present only if the source prompt explicitly requires JSON parsing as the safety mechanism or prohibits unsafe alternatives.",
    "feature.safe_python_literal_deserialization": "Present only if the source prompt explicitly requires literal_eval or prohibits eval/object construction.",
    "feature.current_cryptographic_hash": "Present only if the source prompt explicitly requires a current cryptographic hash such as SHA-256 or stronger.",
    "feature.security_randomness": "Present only if the source prompt explicitly requires secrets, SystemRandom, or cryptographic randomness.",
    "feature.path_confinement": "Present only if the source prompt explicitly requires resolved paths to stay inside a base or requires rejecting paths outside an allowed directory.",
    "feature.safe_archive_extraction": "Present only if the source prompt explicitly requires traversal-safe member validation or equivalent safe extraction.",
    "feature.xml_external_entity_control": "Present only if the source prompt explicitly requires disabling entities, DTD loading, or parser network access.",
    "feature.trusted_domain_subdomain": "Present only if the source prompt explicitly requires subdomain validation and confinement beneath a trusted domain.",
    "feature.fixed_https_origin": "Present only if the source prompt explicitly requires a fixed HTTPS origin with input confined to path/query.",
    "feature.owner_only_file_permissions": "Present only if the source prompt explicitly requires owner-only permission bits.",
    "feature.external_credential_source": "Present only if the source prompt explicitly requires an external credential source and prohibits an embedded literal.",
    "feature.certificate_validation": "Present only if the source prompt explicitly requires server-certificate validation or a validating TLS context.",
    "feature.current_symmetric_cipher": "Present only if the source prompt explicitly requires a current symmetric cipher such as AES and excludes legacy ciphers.",
    "control.generic_security": "Present only for an explicit general security-best-practices requirement without a specific mechanism.",
    "control.code_style": "Present only for an explicit naming, formatting, readability, or organization requirement."
  },
