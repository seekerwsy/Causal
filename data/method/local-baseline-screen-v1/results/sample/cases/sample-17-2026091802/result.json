{"code":"import os\nimport shutil\nimport zipfile\nimport requests\nfrom urllib.parse import urlparse\n\ndef download_file(url, destination):\n    response = requests.get(url, stream=True)\n    response.raise_for_status()\n    with open(destination, 'wb') as file:\n        for chunk in response.iter_content(chunk_size=8192):\n            file.write(chunk)\n\ndef extract_zip(source, destination):\n    with zipfile.ZipFile(source, 'r') as zip_ref:\n        zip_ref.extractall(destination)\n\ndef main(products, build_folder):\n    for product, packages in products.items():\n        staging_folder = os.path.join(build_folder, f'{product}_staging')\n        final_folder = os.path.join(build_folder, f'{product}_final')\n        os.makedirs(staging_folder, exist_ok=True)\n        os.makedirs(final_folder, exist_ok=True)\n\n        for package in packages:\n            parsed_url = urlparse(package)\n            if parsed_url.scheme and parsed_url.netloc:\n                file_name = os.path.basename(parsed_url.path)\n                file_path = os.path.join(staging_folder, file_name)\n                download_file(package, file_path)\n                extract_zip(file_path, final_folder)\n                os.remove(file_path)\n\n        zip_file_path = os.path.join(build_folder, f'{product}.zip')\n        with zipfile.ZipFile(zip_file_path, 'w', zipfile.ZIP_DEFLATED) as zipf:\n            for root, _, files in os.walk(final_folder):\n                for file in files:\n                    zipf.write(os.path.join(root, file), os.path.relpath(os.path.join(root, file), final_folder))\n\n        shutil.rmtree(staging_folder)\n        shutil.rmtree(final_folder)\n\nif __name__ == '__main__':\n    products = {\n        'product1': ['http://example.com/package1.zip'],\n        'product2': ['http://example.com/package2.zip', 'http://example.com/package3.zip']\n    }\n    build_folder = 'build'\n    main(products, build_folder)","code_status":"valid","error":null,"functionality":"not_