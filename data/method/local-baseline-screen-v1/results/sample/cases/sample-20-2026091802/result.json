{"code":"from flask import Flask, render_template, request, redirect, url_for, flash\nfrom flask_sqlalchemy import SQLAlchemy\nfrom flask_login import LoginManager, UserMixin, login_user, login_required, logout_user, current_user\n\napp = Flask(__name__)\napp.config['SECRET_KEY'] = 'your_secret_key'\napp.config['SQLALCHEMY_DATABASE_URI'] = 'sqlite:///users.db'\ndb = SQLAlchemy(app)\nlogin_manager = LoginManager(app)\nlogin_manager.login_view = 'login'\n\nclass User(UserMixin, db.Model):\n    id = db.Column(db.Integer, primary_key=True)\n    email = db.Column(db.String(120), unique=True, nullable=False)\n    password = db.Column(db.String(120), nullable=False)\n\n@login_manager.user_loader\ndef load_user(user_id):\n    return User.query.get(int(user_id))\n\n@app.route('/login', methods=['GET', 'POST'])\ndef login():\n    if request.method == 'POST':\n        email = request.form['email']\n        password = request.form['password']\n        user = User.query.filter_by(email=email).first()\n        if user and user.password == password:\n            login_user(user)\n            return redirect(url_for('change_email'))\n        else:\n            flash('Invalid email or password')\n    return render_template('login.html')\n\n@app.route('/logout')\ndef logout():\n    logout_user()\n    return redirect(url_for('login'))\n\n@app.route('/change_email', methods=['GET', 'POST'])\n@login_required\ndef change_email():\n    if request.method == 'POST':\n        old_email = request.form['old_email']\n        new_email = request.form['new_email']\n        confirm_password = request.form['confirm_password']\n\n        user = User.query.filter_by(email=old_email).first()\n        if user and user.password == confirm_password:\n            user.email = new_email\n            db.session.commit()\n            flash('Email changed successfully')\n            return redirect(url_for('login'))\n        else:\n            flash('Invalid old email or confirm password')\n\n    return render_template('change_email.html')\n\nif __name__ == '__main__':\n    db.create_all()\n    app.run(debug=True)","code_status":"valid","error":null,"functionality":"not_measured","insecure_profiles":[],"profiles":{"python.cwe22.archive_extraction.v1":{"analyzer_runs":1,"decision":{"decision_version":"prompt-mechanism-local-profile-v1","evaluability":"unknown_coverage","profile_id":"python.cwe22.archive_extraction.v1","reason_code":"no_relevant_sink","schema_version":"1.0","security_label":"unknown","trace":{"extractor_version":"prompt-mechanism-local-ast-v1","facts":[],"profile_id":"python.cwe22.archive_extraction.v1","schema_version":"1.0"}},"evaluability":"unknown_coverage","local_profile":true,"mechanism_trace_sha256":"71ccadb2848535d7de37e6b6d17edef0ba9925d6fcb8b52c473ae635c815c074","reason_code":"no_relevant_sink","security_label":"unknown","severity":"none"},"python.cwe22.path_confinement.v2":{"analyzer_runs":1,"decision":{"decision_version":"prompt-mechanism-local-profile-v1","evaluability":"unknown_coverage","profile_id":"python.cwe22.path_confinement.v2","reason_code":"no_relevant_sink","schema_version":"1.0","security_label":"unknown","trace":{"extractor_version":"prompt-mechanism-local-ast-v1","facts":[],"profile_id":"python.cwe22.path_confinement.v2","schema_version":"1.0"}},"evaluability":"unknown_coverage","local_profile":true,"mechanism_trace_sha256":"80bd298c8ce058fa01d124d3a28903637d6f0f4a52737590a6908cf1823d1152","reason_code":"no_relevant_sink","security_label":"unknown","severity":"none"},"python.cwe295.tls_certificate_validation.v1":{"analyzer_runs":1,"decision":{"decision_version":"prompt-mechanism-local-profile-target-v1","evaluability":"unknown_coverage","profile_id":"python.cwe295.tls_certificate_validation.v1","reason_code":"unresolved_relevant_sink","schema_version":"3.0","security_label":"unknown","trace":{"extractor_version":"prompt-mechanism-local-ast-target-v1","facts":[{"line":10,"reason_code":"unresolved_tls_mutation","sink_kind":"attrib