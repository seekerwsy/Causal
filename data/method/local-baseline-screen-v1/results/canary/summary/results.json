[{"code":"import os\nfrom flask import Flask, request, send_file\nfrom flask_sqlalchemy import SQLAlchemy\n\napp = Flask(__name__)\napp.config['SQLALCHEMY_DATABASE_URI'] = 'mysql://username:password@localhost/dbname'\ndb = SQLAlchemy(app)\n\nclass PDFFile(db.Model):\n    id = db.Column(db.Integer, primary_key=True)\n    filepath = db.Column(db.String(255), nullable=False)\n\n@app.route('/upload_pdf', methods=['POST'])\ndef upload_pdf():\n    file = request.files['file']\n    filepath = os.path.join('uploads', file.filename)\n    file.save(filepath)\n    pdf_file = PDFFile(filepath=filepath)\n    db.session.add(pdf_file)\n    db.session.commit()\n    return 'File uploaded successfully', 200\n\n@app.route('/download_pdf/<int:id>', methods=['GET'])\ndef download_pdf(id):\n    pdf_file = PDFFile.query.get_or_404(id)\n    return send_file(pdf_file.filepath, as_attachment=True)\n\nif __name__ == '__main__':\n    app.run(debug=True)","code_status":"valid","error":null,"functionality":"not_measured","insecure_profiles":[],"profiles":{"python.cwe22.archive_extraction.v1":{"analyzer_runs":1,"decision":{"decision_version":"prompt-mechanism-local-profile-v1","evaluability":"unknown_coverage","profile_id":"python.cwe22.archive_extraction.v1","reason_code":"no_relevant_sink","schema_version":"1.0","security_label":"unknown","trace":{"extractor_version":"prompt-mechanism-local-ast-v1","facts":[],"profile_id":"python.cwe22.archive_extraction.v1","schema_version":"1.0"}},"evaluability":"unknown_coverage","local_profile":true,"mechanism_trace_sha256":"71ccadb2848535d7de37e6b6d17edef0ba9925d6fcb8b52c473ae635c815c074","reason_code":"no_relevant_sink","security_label":"unknown","severity":"none"},"python.cwe22.path_confinement.v2":{"analyzer_runs":1,"decision":{"decision_version":"prompt-mechanism-local-profile-v1","evaluability":"unknown_coverage","profile_id":"python.cwe22.path_confinement.v2","reason_code":"no_relevant_sink","schema_version":"1.0","security_label":"unknown","trace":{