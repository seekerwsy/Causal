{
  "json_schema": {
    "name": "source_candidate_review",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "arms_or_outcomes_used": {
          "type": "boolean"
        },
        "decisions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "context_independent": {
                "type": "boolean"
              },
              "decision": {
                "enum": [
                  "accept",
                  "reject",
                  "unresolved"
                ],
                "type": "string"
              },
              "feature_id": {
                "type": "string"
              },
              "normalization_valid": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string"
              },
              "scope_preserves_task": {
                "type": "boolean"
              },
              "single_requirement": {
                "type": "boolean"
              },
              "source_supported": {
                "type": "boolean"
              }
            },
            "required": [
              "feature_id",
              "decision",
              "rationale",
              "source_supported",
              "single_requirement",
              "normalization_valid",
              "context_independent",
              "scope_preserves_task"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "request_sha256": {
          "type": "string"
        },
        "response_sha256": {
          "type": "string"
        },
        "reviewer_id": {
          "type": "string"
        }
      },
      "required": [
        "request_sha256",
        "response_sha256",
        "reviewer_id",
        "arms_or_outcomes_used",
        "decisions"
      ],
      "type": "object"
    },
    "strict": false
  },
  "type": "json_schema"
}
